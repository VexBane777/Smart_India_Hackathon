# Audio must never enter git (per VAANI Global Constraints)
*.wav
*.flac
*.mp3
*.ogg
*.opus
*.m4a

# The nyaya project lives in its own worktree/branch, not on vaani
/nyaya/
/DVR/

# Python / general
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data / runs (large or generated)
/data/
/runs/
*.parquet
*.onnx
*.pth
# Exception: the one .onnx actually shipped as an app asset (replaces the
# old voice_detector.tflite — see voice_guard/lib/services/src/tflite_io.dart).
# Every other .onnx (training runs, intermediates) stays ignored above.
!voice_guard/assets/models/voice_detector.onnx

# Superpowers SDD scratch workspace (git-ignored per skill)
.superpowers/

# Superpowers worktree fallback
.worktrees/

# Flutter / Android / Scratch
**/build/
**/.dart_tool/
**/.flutter-plugins*
**/android/local.properties
**/.gradle/
**/.idea/
**/.kotlin/
*.iml
_*.txt
fix_*.py
