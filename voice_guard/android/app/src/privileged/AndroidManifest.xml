<!--
  Manifest overlay for the "privileged" product flavor (see app/build.gradle.kts).
  Merged by AGP on top of src/main/AndroidManifest.xml.

  CAPTURE_AUDIO_OUTPUT is a signature|privileged permission: declaring it here
  has no effect for a normal (non-system) install — Android silently denies
  it — it only becomes real once this APK is installed as a privileged system
  app via magisk-privileged-module/ (system/priv-app placement + the matching
  privapp-permissions allowlist entry in that module). See that directory's
  README for the full install path and why this flavor must not be
  distributed through the Play Store or a normal sideload.

  Granting this unlocks AudioCaptureManager's existing VOICE_CALL/
  VOICE_DOWNLINK/VOICE_UPLINK AudioSource cascade entries (see that class's
  docstring) with no other code change: those sources already exist in the
  cascade and are simply unreachable without this permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
</manifest>
